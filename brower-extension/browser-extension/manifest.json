{
  "manifest_version": 3,

  "name": "ProdSight Tracker",

  "version": "1.0",

  "description":
    "Tracks website usage",

  "permissions": [

    "tabs",
    "activeTab",
    "storage"

  ],

  "host_permissions": [

    "<all_urls>"

  ],

  "background": {

    "service_worker":
      "background.js"

  }

}